# syntax=docker/dockerfile:1
FROM nvidia/cuda:12.4.0-devel-ubuntu22.04 AS builder

# Prevent interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

# Install core build dependencies, CMake, Python, and development libraries
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    git \
    python3 \
    python3-pip \
    python3-dev \
    cuda-nsight-systems-12-4 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# Install Python scientific dependencies
RUN pip3 install --no-cache-dir numpy

# Copy project source code
COPY . /workspace

# Build C++ & CUDA binaries
RUN mkdir -p build && cd build && \
    cmake .. -DCMAKE_BUILD_TYPE=Release && \
    make -j$(nproc)

# Default command runs the benchmark suite
CMD ["./build/cuda_benchmark"]
